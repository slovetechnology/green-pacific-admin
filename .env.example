# Base URL of the API, used by the browser build (set at BUILD time).
#   - Leave empty / unset: same origin ("/api/..."). Works with the Vite dev
#     proxy (npm run dev) or when the backend serves the built app itself.
#   - Separately hosted API: full origin, no trailing slash, e.g.
#       VITE_API_URL=https://api.example.com
#     The API must allow this site's origin via CORS with credentials.
VITE_API_URL=

# Ad tracking on the public /quote pages only (the Growth Engine). Staff pages never load these tags.
#   VITE_GTM_ID         Google Tag Manager container, e.g. GTM-ABC1234
#   VITE_META_PIXEL_ID  Meta Pixel / dataset id (digits); the same id as META_PIXEL_ID on the API
VITE_GTM_ID=
VITE_META_PIXEL_ID=
